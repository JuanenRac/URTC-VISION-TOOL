{
 "needs_linux_host": false,
 "analyze": false,
 "coverage_prefix": "src/",
 "warn": [
  "-Wall",
  "-Wextra",
  "-Wconversion"
 ],
 "sanitize_flags": [
  "-fsanitize=address,undefined",
  "-fno-sanitize-recover=undefined"
 ],
 "suites": [
  {
   "name": "host_logic",
   "test": "tests/test_main.c",
   "sources": [
    "glob:tests/test_*.c",
    "src/melexis_config.c",
    "src/rate_limiter.c",
    "src/sensor_diagnostics.c",
    "src/sensor_frame.c",
    "src/sensor_freshness.c",
    "src/sensor_reading.c",
    "src/sensor_rx.c",
    "src/vision_sensor_link.c"
   ],
   "includes": [
    "src",
    "tests"
   ],
   "std": "c11",
   "sanitize": "env:URTC_SANITIZE"
  },
  {
   "name": "isr_simulator",
   "test": "tests/isr_simulator.c",
   "sources": [
    "src/melexis_config.c",
    "src/rate_limiter.c",
    "src/sensor_diagnostics.c",
    "src/sensor_frame.c",
    "src/sensor_freshness.c",
    "src/sensor_reading.c",
    "src/sensor_rx.c",
    "src/vision_sensor_link.c"
   ],
   "includes": [
    "src",
    "tests"
   ],
   "std": "c11",
   "sanitize": "env:URTC_SANITIZE"
  }
 ],
 "coverage_exclude": [
  "src/vision_companion/"
 ]
}
