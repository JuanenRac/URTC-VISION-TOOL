build/

# vision_companion (Python) - venvs and packaging artifacts, never committed
src/vision_companion/.venv/
src/vision_companion/build/
src/vision_companion/*.egg-info/
src/vision_companion/selftest_output/
__pycache__/
*.pyc
# HYDRA-UMC shared secret protection
.env
.env.*
!.env.example

# Firmware images are published only as assets of the GitHub release of their
# version (tools/publish_release_assets.py); build_firmware.sh writes them here.
firmware/*.bin
firmware/*.elf
firmware/*.hex
firmware/*.sha256
